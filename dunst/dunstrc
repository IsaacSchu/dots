# wired — dark cyberpunk dunst theme
# "No matter where you go, everyone's connected."

[global]
    monitor = 0
    follow = mouse

    width = 520
    height = (0, 400)
    origin = top-right
    offset = (24, 64)
    scale = 0
    notification_limit = 5

    progress_bar = true
    progress_bar_height = 6
    progress_bar_frame_width = 0
    progress_bar_min_width = 280
    progress_bar_max_width = 480
    highlight = "#B08AE6"

    indicate_hidden = yes
    transparency = 0
    separator_height = 2
    separator_color = "#B08AE633"

    padding = 24
    horizontal_padding = 28
    text_icon_padding = 20

    frame_width = 2
    frame_color = "#B08AE680"
    corner_radius = 16

    sort = yes
    idle_threshold = 120

    font = Noto Sans Mono Medium 14
    line_height = 4
    markup = full
    format = "<b>%s</b> %p\n%b"
    alignment = left
    vertical_alignment = center
    show_age_threshold = 60
    ellipsize = middle
    ignore_newline = no
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = no

    icon_position = left
    min_icon_size = 48
    max_icon_size = 64
    icon_path = /usr/share/icons/gnome/16x16/status/:/usr/share/icons/gnome/16x16/devices/

    sticky_history = yes
    history_length = 20

    dmenu = /usr/bin/dmenu -p dunst:
    browser = /usr/bin/firefox -new-tab
    always_run_script = true
    title = Dunst
    class = Dunst

    ignore_dbusclose = false
    force_xwayland = false
    force_xinerama = false

    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

[experimental]
    per_monitor_dpi = false

[urgency_low]
    background = "#0a0e14AA"
    foreground = "#8672B0"
    frame_color = "#8672B050"
    timeout = 10

[urgency_normal]
    background = "#0a0e14BB"
    foreground = "#C1B9D8"
    frame_color = "#B08AE680"
    timeout = 20

[urgency_critical]
    background = "#1a0a1eBB"
    foreground = "#CC4466"
    frame_color = "#CC4466"
    timeout = 0

[fullscreen_show_critical]
    fullscreen = show

# vim: ft=cfg
