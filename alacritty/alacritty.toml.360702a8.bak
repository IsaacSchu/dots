[font]
size = 27
[colors.bright]
black = "#777777"
blue = "#6f8fdb"
cyan = "#4ac9e2"
green = "#88db3f"
magenta = "#e987e9"
red = "#f36868"
white = "#FFFFFF"
yellow = "#f0bf7a"

[colors.cursor]
cursor = "#915caf"
text = "#0E1415"

[colors.normal]
black = "#0E1415"
blue = "#4a88e4"
cyan = "#23acdd"
green = "#73ca50"
magenta = "#915caf"
red = "#e25d56"
white = "#f0f0f0"
yellow = "#e9bf57"

[colors.primary]
background = "#000000"
foreground = "#C1B9D8"

[colors.selection]
background = "#874ed9"
text = "#000000"

[cursor.style]
blinking = "On"
shape = "Beam"

[window]
opacity = 0.80
dynamic_title = true

[terminal.shell]
program = "/bin/zsh"
