{
    "margin-top" : 0,
    "margin-left": -2,
    "margin-right": -2,
    "height" : 30,
    "modules-left": [
        "hyprland/workspaces",
        "tray",
    ],
    "modules-center": [
        "hyprland/window",
    ],
    "modules-right": [
        "pulseaudio",
        "mpris",
        "network",
        "cpu",
        "temperature",
        "clock"
    ],
    "hyprland/workspaces": {
        "format": "{icon}",
        "on-click": "activate",
        "show-special": true,
        "format-icons": {
//            "active": "{number}",
            //
        },
        "sort-by-number": true
    },
    "hyprland/window":{
        "max-length": 100,
        "icon": false,
        "icon-size": 12,
        "on-click": "bash /home/lain/bin/wallpapers/wallpaper.sh"

    },
    "hyprland/window#icon":{
        "format": {},
        "rewrite": {".+": ""},
        "icon": true,
        "icon-size": 20
    },

    "clock": {
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "timezone": "America/New_York",
        "format-alt": "{:%m-%d-%Y %H:%M:%S}"
    },
    "cpu": {
        "format": "{usage}%",
        "tooltip": false,
        "on-click": "alacritty -e htop"
    },
    "memory": {
        "format": "{}%  ",
        "on-click": "alacritty -e htop"
    },
    "temperature": {
        "critical-threshold": 80,
        "format": "{temperatureF}°F",
        "format-icons": ["", "", ""],
        "on-click": "alacritty -e htop"
    },
    "tray": {
        "icon-size": 18,
        "spacing": 8,
        "show-passive-items": true,
    },
    "network": {
        "format-wifi": "  {signalStrength}%",
        "format-ethernet":"",
        "format-alt": "{bandwidthUpBytes} 🡱  {bandwidthDownBytes} 🡳",
        "tooltip-format": "{ifname} via {gwaddr} ",
        "format-linked": "{ifname} (No IP) ",
        "format-disconnected": " ⚠ ",
    },
    "pulseaudio": {
        "format": "{icon}  {volume}%",
        "format-bluetooth": "{volume}% {icon}",
        "format-bluetooth-muted": " {icon} {format_source}",
        "format-muted": " {format_source}",
        "format-icons": {
            "headphone": "",
            "hands-free": "",
            "headset": "",
            "phone": "",
            "portable": "",
            "car": "",
            "default": ["", "", ""]
        },
        "on-click": "pavucontrol"
    },
    "mpris":{
        "format": " {status_icon} [ {title} - {artist} {album}]",
        "title-len": 60,
        "artist-len": 20,
        "album-len": 25,
        "status-icons":{
            "playing": "►",
            "paused": "⏸️",
            "stopped":"⏹️",
        }
    }
} 
